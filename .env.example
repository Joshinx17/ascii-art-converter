# ============================================================
# Environment Variables — ASCII Art Converter
# Copy this file to .env and fill in the values.
# ============================================================

# ------------------------------------------------------------
# Frontend (ascii-converter Vite app)
# ------------------------------------------------------------

# Port the dev server listens on
PORT=5173

# Base URL path for the app (use "/" for root deployment)
BASE_PATH=/

# ------------------------------------------------------------
# Backend (api-server Express app)
# ------------------------------------------------------------

# Port the API server listens on
PORT=3000

# CORS — comma-separated list of allowed origins for production
# Example: https://yourapp.com,https://www.yourapp.com
# Leave empty to allow all origins (development only!)
ALLOWED_ORIGINS=

# Node environment: "development" | "production"
NODE_ENV=development
